{
  "name": "expo-mobile",
  "version": "1.0.0",
  "main": "index.js",
  "dependencies": {
    "@appeeky/expo-healthkit": "^0.4.1",
    "buffer": "^6.0.3",
    "expo": "~58.0.26",
    "expo-battery": "~58.0.4",
    "expo-build-properties": "~58.0.12",
    "expo-notifications": "~58.1.9",
    "expo-secure-store": "~58.0.3",
    "expo-sensors": "~58.0.5",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-ble-plx": "^3.5.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-webview": "14.0.1"
  },
  "scripts": {
    "start": "node ../scripts/sync-dev-ip.js && expo start --go -c",
    "start:tunnel": "node ../scripts/sync-dev-ip.js && expo start --go --tunnel -c",
    "android": "node ../scripts/sync-dev-ip.js && expo run:android",
    "ios": "node ../scripts/sync-dev-ip.js && expo run:ios",
    "web": "expo start -c --web"
