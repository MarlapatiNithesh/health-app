# Application
PORT=4000
STORE=postgres

DATABASE_URL=postgres://wellness_app:wellness_app@localhost:5432/wellness_db

# Security
JWT_SECRET=c2VjdXJlLXdlbGxuZXNzLWFwcC1qd3Qtc2VjcmV0LWtleS0yMDI2
JWT_EXPIRES_IN=7d

# Health data
HEALTH_BATCH_LIMIT=200

# Optional: enable inbound provider webhooks by setting a shared secret
WEBHOOK_SECRET=your_webhook_secret_here

# Open Wearables API Integration
OPEN_WEARABLES_BASE_URL=http://localhost:8000
OPEN_WEARABLES_API_KEY=your_open_wearables_api_key_here

# Twilio Verify (SMS & WhatsApp)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_VERIFY_SERVICE_SID=your_twilio_verify_service_sid_here

# ── Unified MediBot Clinical In-Process Configuration ──
NODE_ENV=development

# Storage & Document Pipeline
UPLOAD_DIR=./uploads/medibot
MAX_FILE_SIZE_MB=20
OCR_PROVIDER=local_tesseract

# AWS S3 Document Vault Configuration (Cloud Object Storage)
AWS_S3_BUCKET=medibot-clinical-docs
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_ENDPOINT_URL=http://localhost:4566

# Clinical Extraction Thresholds
CONFIDENCE_AUTO_COMMIT=0.85
CONFIDENCE_USER_CONFIRM=0.60

# Rate Limiting & CORS
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:4000

# AI / LLM Configuration (Gemini / OpenAI for clinical triage & function calling)
GEMINI_API_KEY=
GEMINI_ENDPOINT_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-flash-latest:generateContent
GEMINI_MODEL=gemini-flash-latest
OPENAI_API_KEY=

# ── Notification System ──────────────────────────────────────────────
# Firebase Cloud Messaging (Android push)
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
# Or use service account JSON file path:
# GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json

# Apple Push Notification Service (iOS push)
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_KEY_PATH=./certs/apns-auth-key.p8
APNS_BUNDLE_ID=com.yourapp.health
APNS_PRODUCTION=false

# Notification scheduler (poll interval in ms, default 30000)
NOTIFICATION_SCHEDULER_INTERVAL_MS=30000

# Redis (used by BullMQ for async push queue)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
