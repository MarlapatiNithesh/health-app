# Application
PORT=4000
STORE=postgres

DATABASE_URL=postgres://wellness_app:wellness_app@localhost:5432/wellness_db

# Security
JWT_SECRET=your_jwt_secret_key_at_least_32_characters_long
JWT_EXPIRES_IN=7d

# Health data
HEALTH_BATCH_LIMIT=200

# Optional: enable inbound provider webhooks by setting a shared secret
WEBHOOK_SECRET=whsec_placeholder_webhook_signing_secret

# Open Wearables API Integration
OPEN_WEARABLES_BASE_URL=http://localhost:8000
OPEN_WEARABLES_REDIRECT_URL=goqiihealth://wearables/callback
REDIRECT_ALLOWLIST=goqiihealth://wearables/callback
OPEN_WEARABLES_API_KEY=

# Twilio Verify (SMS & WhatsApp)
TWILIO_ACCOUNT_SID=AC00000000000000000000000000000000
TWILIO_AUTH_TOKEN=placeholder_twilio_auth_token
TWILIO_VERIFY_SERVICE_SID=VA00000000000000000000000000000000

# ── Unified MediBot Clinical In-Process Configuration ──
NODE_ENV=development

# Storage & Document Pipeline
UPLOAD_DIR=./uploads/medibot
MAX_FILE_SIZE_MB=20
OCR_PROVIDER=local_tesseract

# AWS S3 Document Vault Configuration (Cloud Object Storage)
AWS_S3_BUCKET=medibot-clinical-docs
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_ENDPOINT_URL=http://localhost:4566

# Clinical Extraction Thresholds
CONFIDENCE_AUTO_COMMIT=0.85
CONFIDENCE_USER_CONFIRM=0.60

# Rate Limiting & CORS
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:4000

# AI / LLM Configuration (Gemini / OpenAI for clinical triage & function calling)
GEMINI_API_KEY=
GEMINI_ENDPOINT_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-flash-latest:generateContent
GEMINI_MODEL=gemini-flash-latest
OPENAI_API_KEY=
